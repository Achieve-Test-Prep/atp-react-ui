{
  "name": "atp-react-ui",
  "description": "A new default theme for ATP Products.",
  "private": false,
  "version": "4.0.16",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style/atp-css-styles.css": "./style/atp-css-styles.css",
    "./style/fonts.css": "./style/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "style",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Achieve-Test-Prep/atp-react-ui.git"
  },
  "keywords": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Achieve-Test-Prep/atp-react-ui/issues"
  },
  "homepage": "https://github.com/Achieve-Test-Prep/atp-react-ui#readme",
  "release-it": {
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./style/tailwind.css -o ./style/atp-css-styles.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./style/tailwind.css -o ./style/atp-css-styles.css --watch",
    "build": "npm run build:css && tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css}'",
    "storybook": "npm run build:css && storybook dev -p 6006",
    "build-storybook": "npm run build:css && storybook build",
    "cz": "git-cz",
    "prerelease": "npm run build",
    "release": "release-it",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1",
    "react-hook-form": ">=7.71.2",
    "tailwindcss": ">=4.1.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^9.21.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-links": "^10.5.9",
    "@storybook/addon-onboarding": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "release-it": "^21.0.2",
    "storybook": "^10.5.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.0.2",
    "@tippyjs/react": "^4.2.6",
    "tailwind-merge": "^3.6.0"
  }
}
